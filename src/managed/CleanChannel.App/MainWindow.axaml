<Window
    x:Class="CleanChannel.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:CleanChannel.App.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Width="1120"
    Height="760"
    MinWidth="760"
    MinHeight="560"
    Background="{DynamicResource CleanChannelPageBrush}"
    Title="CleanChannel"
    WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Shift+M" Command="{Binding ToggleFullMuteCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding ToggleFullOffCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="ListBox.sidebar-nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,8" />
    </Style>
    <Style Selector="ListBox.sidebar-nav ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource CleanChannelTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Margin" Value="6,2" />
      <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style Selector="ListBox.sidebar-nav ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource CleanChannelSurfaceStrongBrush}" />
    </Style>
    <Style Selector="ListBox.sidebar-nav ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource CleanChannelAccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource CleanChannelSidebarSelectedTextBrush}" />
    </Style>
    <Style Selector="ListBox.sidebar-nav ListBoxItem:selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource CleanChannelAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource CleanChannelTextBrush}" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource CleanChannelTextBrush}" />
    </Style>
    <Style Selector="Border.surface-card">
      <Setter Property="Background" Value="{DynamicResource CleanChannelSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CleanChannelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18" />
    </Style>
  </Window.Styles>

  <SplitView IsPaneOpen="True"
             DisplayMode="Inline"
             OpenPaneLength="232"
             CompactPaneLength="52"
             AutomationProperties.Name="CleanChannel application shell">
    <SplitView.Pane>
      <Border
            Background="{DynamicResource CleanChannelSurfaceBrush}"
            BorderBrush="{DynamicResource CleanChannelBorderBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Padding="22,24,18,20">
          <StackPanel Spacing="3">
            <TextBlock FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CleanChannelTextBrush}"
                       Text="CleanChannel" />
            <TextBlock FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CleanChannelAccentBrush}"
                       Text="AUDIO CONTROL" />
          </StackPanel>
        </Border>

        <ListBox Grid.Row="1"
                 Classes="sidebar-nav"
                 ItemsSource="{Binding NavigationItems}"
                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                 AutomationProperties.Name="Main navigation">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock FontSize="14" Text="{Binding}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CleanChannelBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,14">
          <StackPanel Spacing="3">
            <TextBlock FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource CleanChannelMutedBrush}"
                       Text="RUNTIME" />
            <TextBlock Foreground="{DynamicResource CleanChannelTextBrush}" Text="{Binding ReadinessLabel}" />
            <TextBlock FontSize="12" Foreground="{DynamicResource CleanChannelMutedBrush}" Text="{Binding BackendLabel}" />
          </StackPanel>
        </Border>
      </Grid>
      </Border>
    </SplitView.Pane>

    <Grid RowDefinitions="Auto,*,Auto">
      <Border Grid.Row="0"
              Background="{DynamicResource CleanChannelSurfaceBrush}"
              BorderBrush="{DynamicResource CleanChannelBorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="28,20">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="3">
            <TextBlock Classes="page-title" Text="{Binding SelectedNavigationItem}" />
            <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="Fast, local control for every audio channel" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button AutomationProperties.Name="Refresh AudioHost state" Command="{Binding RefreshCommand}" Content="Refresh" />
            <Button AutomationProperties.Name="Mute all channels" Command="{Binding ToggleFullMuteCommand}" Content="{Binding FullMuteLabel}" />
            <Button AutomationProperties.Name="Disable or restore all virtual audio" Command="{Binding ToggleFullOffCommand}" Content="{Binding FullOffLabel}" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
          <StackPanel IsVisible="{Binding IsDashboardPageVisible}" Spacing="20">
            <Border Classes="surface-card" Background="{DynamicResource CleanChannelSurfaceStrongBrush}">
              <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource CleanChannelWarningBrush}" Margin="0,5,12,0" />
                <StackPanel Grid.Column="1" Spacing="4">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="section-title" Text="AudioHost" />
                    <TextBlock Classes="section-title" Foreground="{DynamicResource CleanChannelWarningBrush}" Text="{Binding ReadinessLabel}" />
                  </StackPanel>
                  <TextBlock Foreground="{DynamicResource CleanChannelTextBrush}" Text="{Binding StatusMessage}" AutomationProperties.LiveSetting="Polite" />
                  <TextBlock Foreground="{DynamicResource CleanChannelStatusBrush}" Text="{Binding ProcessingLabel}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Foreground="{DynamicResource CleanChannelMutedBrush}" Text="{Binding BackendLabel}" VerticalAlignment="Top" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" Foreground="{DynamicResource CleanChannelMutedBrush}" Text="{Binding ActionStateLabel}" />
              </Grid>
            </Border>

            <Border Classes="surface-card">
              <StackPanel Spacing="10">
                <TextBlock Classes="section-title" Text="Welcome to CleanChannel" />
                <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="Use the sidebar to manage channels, physical devices, EQ profiles, and recovery controls." TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Command="{Binding ToggleFullMuteCommand}" Content="{Binding FullMuteLabel}" />
                  <Button Command="{Binding ToggleFullOffCommand}" Content="{Binding FullOffLabel}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsChannelsPageVisible}" Spacing="20">
            <StackPanel Spacing="3">
              <TextBlock Classes="section-title" Text="Channels" />
              <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="Adjust the control-plane state that will later drive the native AudioHost." TextWrapping="Wrap" />
              <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="Ctrl+Shift+M · full mute   Ctrl+Shift+O · full off" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Channels}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" ItemWidth="420" ItemHeight="300" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChannelViewModel">
                  <Border AutomationProperties.Name="{Binding AccessibilityName}" Margin="0,0,16,16" Padding="18" Background="{DynamicResource CleanChannelSurfaceBrush}" BorderBrush="{DynamicResource CleanChannelBorderBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource CleanChannelTextBrush}" Text="{Binding DisplayName}" />
                        <TextBlock Grid.Column="1" Foreground="{DynamicResource CleanChannelStatusBrush}" Text="{Binding StatusLabel}" AutomationProperties.Name="{Binding StatusLabel}" />
                      </Grid>
                      <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                        <Slider AutomationProperties.Name="{Binding VolumeAccessibilityLabel}" IsEnabled="{Binding CanEdit}" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" />
                        <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="{DynamicResource CleanChannelTextBrush}" Text="{Binding VolumeLabel}" VerticalAlignment="Center" />
                      </Grid>
                      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.Name="{Binding MuteAccessibilityLabel}" IsEnabled="{Binding CanEdit}" Command="{Binding ToggleMuteCommand}" Content="{Binding MuteButtonLabel}" />
                        <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="{Binding RouteLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Row="3" Spacing="5">
                        <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="Channel output" />
                        <ComboBox AutomationProperties.Name="{Binding OutputAccessibilityLabel}" IsEnabled="{Binding CanEdit}" ItemsSource="{Binding AvailableOutputDevices}" SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AudioDeviceViewModel">
                              <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Row="4" Spacing="5">
                        <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="EQ profile" />
                        <ComboBox AutomationProperties.Name="{Binding EqAccessibilityLabel}" IsEnabled="{Binding CanEdit}" ItemsSource="{Binding AvailableEqProfiles}" SelectedItem="{Binding SelectedEqProfile, Mode=TwoWay}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:EqProfileViewModel">
                              <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsDevicesPageVisible}" Spacing="20">
            <StackPanel Spacing="3">
              <TextBlock Classes="section-title" Text="Devices" />
              <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="Choose the physical endpoints used by the control plane." TextWrapping="Wrap" />
            </StackPanel>
            <Border Classes="surface-card">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                <StackPanel Spacing="6">
                  <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="Output device" />
                  <ComboBox AutomationProperties.Name="Selected output device" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AudioDeviceViewModel">
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="Microphone" />
                  <ComboBox AutomationProperties.Name="Selected microphone" ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInputDevice, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:AudioDeviceViewModel">
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsProfilesPageVisible}" Spacing="20">
            <StackPanel Spacing="3">
              <TextBlock Classes="section-title" Text="Profiles" />
              <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="Available EQ profiles can be assigned from each channel." TextWrapping="Wrap" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding EqProfiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EqProfileViewModel">
                  <Border Classes="surface-card" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="4">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource CleanChannelTextBrush}" Text="{Binding DisplayName}" />
                        <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Foreground="{DynamicResource CleanChannelMutedBrush}" Text="Demo profile" IsVisible="{Binding IsDemo}" VerticalAlignment="Top" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsSettingsPageVisible}" Spacing="20">
            <StackPanel Spacing="3">
              <TextBlock Classes="section-title" Text="Settings" />
              <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="Quick controls and current demo behavior." TextWrapping="Wrap" />
            </StackPanel>
            <Border Classes="surface-card">
              <StackPanel Spacing="12">
                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource CleanChannelTextBrush}" Text="Recovery controls" />
                <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="These controls are available globally from the tray and shortcuts." TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Command="{Binding ToggleFullMuteCommand}" Content="{Binding FullMuteLabel}" />
                  <Button Command="{Binding ToggleFullOffCommand}" Content="{Binding FullOffLabel}" />
                  <Button Command="{Binding RefreshCommand}" Content="Refresh state" />
                </StackPanel>
                <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="Ctrl+Shift+M · full mute   Ctrl+Shift+O · full off / restore" />
              </StackPanel>
            </Border>
            <Border Classes="surface-card" Background="{DynamicResource CleanChannelSurfaceStrongBrush}">
              <StackPanel Spacing="5">
                <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource CleanChannelTextBrush}" Text="Demo status" />
                <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="The control plane is running, but real WASAPI processing and virtual endpoints are not connected in this 0.1 demo." TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Border Grid.Row="2"
              Background="{DynamicResource CleanChannelSurfaceBrush}"
              BorderBrush="{DynamicResource CleanChannelBorderBrush}"
              BorderThickness="0,1,0,0"
              Padding="28,12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Foreground="{DynamicResource CleanChannelMutedBrush}" Text="CleanChannel 0.1 demo · control plane only" />
          <TextBlock Grid.Column="1" Foreground="{DynamicResource CleanChannelMutedBrush}" Text="No real audio processing yet" />
        </Grid>
      </Border>
    </Grid>
  </SplitView>
</Window>
