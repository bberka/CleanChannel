@page
@model CleanChannel.Landing.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<section class="form-shell">
    <p class="eyebrow">Pro account</p>
    <h1>Welcome back.</h1>
    <p class="hint">Log in to activate a demo license and access the separately distributed Pro artifact.</p>
    <form class="form-card" method="post">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <div class="field"><label asp-for="Input.Email"></label><input asp-for="Input.Email" autocomplete="email" /><span asp-validation-for="Input.Email" class="validation"></span></div>
        <div class="field"><label asp-for="Input.Password"></label><input asp-for="Input.Password" autocomplete="current-password" /><span asp-validation-for="Input.Password" class="validation"></span></div>
        <button class="button button-primary" type="submit">Log in</button>
        <p class="form-footer">No account? <a asp-page="/Account/Register">Create one</a></p>
    </form>
</section>
