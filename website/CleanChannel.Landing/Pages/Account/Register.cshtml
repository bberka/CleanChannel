@page
@model CleanChannel.Landing.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<section class="form-shell">
    <p class="eyebrow">Start with a sandbox account</p>
    <h1>Try the Pro gate.</h1>
    <p class="hint">This local demo stores your account in memory. Stop the app and the demo data is gone.</p>
    <form class="form-card" method="post">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <div class="field"><label asp-for="Input.Email"></label><input asp-for="Input.Email" autocomplete="email" /><span asp-validation-for="Input.Email" class="validation"></span></div>
        <div class="field"><label asp-for="Input.Password"></label><input asp-for="Input.Password" autocomplete="new-password" /><small>Use at least 12 characters.</small><span asp-validation-for="Input.Password" class="validation"></span></div>
        <button class="button button-primary" type="submit">Create account</button>
        <p class="form-footer">Already registered? <a asp-page="/Account/Login">Log in</a></p>
    </form>
</section>
